{
  "name": "@foundry/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Platform API: identity, app registry and review, sandboxed runtime, model gateway, connectors, audit",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "node dist/cli/migrate.js",
    "seed": "node dist/cli/seed-world.js",
    "seed:apps": "node dist/cli/seed-apps.js",
    "start": "node dist/main.js",
    "openapi": "node dist/cli/openapi.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@foundry/contract": "workspace:*",
    "@foundry/gate": "workspace:*",
    "@foundry/sandbox": "workspace:*",
    "@hono/node-server": "2.1.5",
    "hono": "4.13.14",
    "ioredis": "6.0.0",
    "jose": "6.2.14",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "ulid": "3.0.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@foundry/mcp": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "vitest": "5.0.5"
  }
}
