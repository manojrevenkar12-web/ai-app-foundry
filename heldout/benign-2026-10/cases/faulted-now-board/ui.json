{
  "pages": [
    {
      "id": "board",
      "title": "Faulted now",
      "blocks": [
        {
          "type": "form",
          "handler": "board",
          "fields": [
            {
              "name": "country",
              "label": "Country",
              "kind": "select",
              "required": true,
              "options": [
                { "value": "DE", "label": "Germany" },
                { "value": "AT", "label": "Austria" },
                { "value": "CZ", "label": "Czech Republic" },
                { "value": "HU", "label": "Hungary" },
                { "value": "PL", "label": "Poland" },
                { "value": "RO", "label": "Romania" },
                { "value": "NL", "label": "Netherlands" },
                { "value": "IT", "label": "Italy" },
                { "value": "DK", "label": "Denmark" },
                { "value": "SE", "label": "Sweden" },
                { "value": "GB", "label": "United Kingdom" }
              ]
            }
          ],
          "submitLabel": "Show faulted charge points",
          "result": [
            {
              "type": "stats",
              "items": [
                { "path": "stats.faulted", "label": "Faulted", "format": "number" },
                { "path": "stats.highPower", "label": "150 kW or more", "format": "number" },
                { "path": "stats.cities", "label": "Cities", "format": "number" }
              ]
            },
            { "type": "markdown", "path": "note" },
            { "type": "chart", "path": "byCity", "kind": "bar", "x": "city", "y": ["faulted"], "yLabel": "Faulted charge points" },
            {
              "type": "table",
              "path": "rows",
              "columns": [
                { "key": "id", "label": "Charge point" },
                { "key": "site", "label": "Site" },
                { "key": "city", "label": "City" },
                { "key": "powerKw", "label": "kW", "format": "number" },
                { "key": "status", "label": "Status", "format": "status" },
                { "key": "lastSeen", "label": "Last seen", "format": "datetime" },
                { "key": "hoursSinceSeen", "label": "Hours since seen", "format": "number" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
