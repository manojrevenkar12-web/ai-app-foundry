[
  {
    "name": "joins faults and tickets",
    "handler": "digest",
    "input": { "country": "DE" },
    "expect": { "contains": ["\"faulted\":1", "\"openTickets\":1", "\"faultedWithoutTicket\":0"] }
  },
  {
    "name": "asks the viewer before posting",
    "handler": "post",
    "input": { "channel": "Field Ops DE", "text": "Weekly digest: 1 faulted, 1 open ticket." },
    "expect": { "contains": ["teams.post", "Field Ops DE"] }
  }
]
