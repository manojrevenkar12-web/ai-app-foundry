[
  {
    "name": "drafts a reply",
    "handler": "draft",
    "input": { "language": "de", "situation": "failed session", "details": "Driver could not start a session in Essen on Monday evening." },
    "expect": { "contains": ["\"language\":\"de\"", "reply"] }
  },
  {
    "name": "keeps a template",
    "handler": "keep",
